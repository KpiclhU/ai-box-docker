# ai-docker — copy to .env, then run ./install.sh (it fills the empty secrets).
#
# Every container is on the LAN itself, so there are no host ports to publish.
# Pick three free addresses OUTSIDE your DHCP pool, then reserve them.

# ---- network ----------------------------------------------------------------
LAN_SUBNET=192.168.150.0/24
LAN_GATEWAY=192.168.150.1
# The block the macvlan network may allocate from. .50 is the VM and .54 is the
# host-side shim, so that block overlaps both — every service pins its own
# address below, which is what keeps the pool from handing either of them out.
LAN_IP_RANGE=192.168.150.48/28
# The VLAN interface carrying the LAN. install.sh detects it if this is wrong.
LAN_PARENT=eth0
# The VM's own address, set in proxmox/create-vm.sh. Recorded here as documentation.
VM_IP=192.168.150.50
# The shim's address, used when the VM talks to its own containers.
SHIM_IP=192.168.150.54

# ---- the model box (ai-box repository) --------------------------------------
AI_BOX_IP=192.168.150.40
LLAMA_URL=http://192.168.150.40:8080/v1
# llama-server has no --api-key in the LAN layout; anything non-empty works.
LLAMA_API_KEY=none
COMFY_URL=http://192.168.150.40:8188

# ---- one static address per container ---------------------------------------
OPENWEBUI_IP=192.168.150.51
OPEN_TERMINAL_IP=192.168.150.52
OPENCLAW_IP=192.168.150.53

# ---- images -----------------------------------------------------------------
# Pin a version tag once the stack has been running happily.
OPENWEBUI_TAG=main
OPEN_TERMINAL_TAG=latest
OPENCLAW_TAG=latest

# ---- secrets (install.sh generates any of these that are empty) --------------
OPENWEBUI_SECRET_KEY=
OPENWEBUI_ADMIN_EMAIL=admin@ai-box.local
OPENWEBUI_ADMIN_PASSWORD=
OPENWEBUI_ADMIN_NAME=Admin
OPEN_TERMINAL_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
